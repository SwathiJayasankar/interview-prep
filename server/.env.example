PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/interview-prep
JWT_SECRET=change-this-to-a-long-random-string
GROQ_API_KEY=your-groq-api-key

# Optional: override the Groq models (these are the defaults)
# GROQ_MODEL_SMART=llama-3.3-70b-versatile   # analysis, evaluation, plans
# GROQ_MODEL_FAST=llama-3.1-8b-instant       # question generation, summaries
# GROQ_MODEL_STT=whisper-large-v3-turbo      # speech-to-text
